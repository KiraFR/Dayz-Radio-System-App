# Copy this file to .env before building. .env is gitignored and is baked into the build.

# Secret code to open manual connection modal on the waiting screen
# Type this code (like a Konami code) to access manual server connection
SECRET_CODE=dayz

# ---------------------------------------------------------------------------
# Build attestation (anti-tamper for the open-source client)
# ---------------------------------------------------------------------------
# Secret baked into the OFFICIAL build only. It must NOT be committed (this repo is
# public) — set it in your local .env at build time. The app signs its Socket.IO
# handshake with it; the VoIP server verifies with the matching CLIENT_ATTESTATION_SECRET.
# A client rebuilt from public sources lacks this secret and is rejected.
# Leave empty to disable attestation. Generate e.g. (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
CLIENT_BUILD_SECRET=

# ---------------------------------------------------------------------------
# Server URL allowlist (optional hardening)
# ---------------------------------------------------------------------------
# Comma-separated hostnames the shell is allowed to load, e.g. radio.example.com
# When set, /connect refuses any other host. When empty, only http/https is enforced.
ALLOWED_SERVER_HOSTS=
